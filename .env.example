# Local backend
OVERROOT_HOST=127.0.0.1
OVERROOT_PORT=4317
OVERROOT_DATA_DIR=./data
OVERROOT_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://overroot.toni.foo
OVERROOT_PUBLIC_URL=https://overroot.toni.foo
OVERROOT_TRUST_PROXY=true

# Optional overrides
OVERROOT_COMPILE_TIMEOUT_SECONDS=45
OVERROOT_COMPILE_MAX_JOBS=8
OVERROOT_COMPILE_MAX_SNAPSHOT_BYTES=134217728
OVERROOT_DOCKER_IMAGE=overroot-tectonic:0.16.9
OVERROOT_DOCKER_CONTAINER=overroot-tectonic-worker
OVERROOT_FAKE_COMPILER=false

# Required shared account issuer and private backchannel config.
OVERROOT_IDENTITY_ORIGIN=https://accounts.toni.foo
OVERROOT_IDENTITY_BASE_URL=http://127.0.0.1:18746
# Set OVERROOT_IDENTITY_CLIENT_SECRET privately. Never commit its value.
