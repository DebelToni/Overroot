{
  "name": "overroot",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@10.27.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @overroot/server --filter @overroot/web dev",
    "dev:server": "pnpm --filter @overroot/server dev",
    "dev:web": "pnpm --filter @overroot/web dev",
    "build": "pnpm -r build",
    "start": "pnpm --filter @overroot/server start",
    "admin:create": "pnpm --filter @overroot/server admin:create",
    "backup": "node scripts/backup.mjs",
    "test": "node --test scripts/deploy.test.mjs && pnpm -r test",
    "test:api": "pnpm --filter @overroot/server test",
    "test:compiler": "OVERROOT_TEST_DOCKER=1 pnpm --filter @overroot/server exec vitest run tests/compiler-docker.test.ts",
    "test:web": "pnpm --filter @overroot/web test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
